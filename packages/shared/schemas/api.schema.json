{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxjob.local/schemas/api.schema.json",
  "title": "NxJob Phase 1 API Schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "sponsorshipStatus": {
      "enum": [
        "supports",
        "does_not_support",
        "likely_supports",
        "likely_not_supports",
        "needs_confirmation",
        "unknown"
      ]
    },
    "applicationStatus": {
      "enum": [
        "captured",
        "reviewing",
        "skipped",
        "tailored",
        "ready_to_apply",
        "applied",
        "replied",
        "interviewing",
        "offer",
        "rejected",
        "closed"
      ]
    },
    "workflowName": {
      "enum": [
        "analyze_sponsorship",
        "tailor_resume",
        "draft_form_answer_from_resume_bullets"
      ]
    },
    "sponsorshipAnalyzeRequest": {
      "type": "object",
      "required": ["job_lead_id"],
      "properties": {
        "job_lead_id": { "type": "string" },
        "jd_text": { "type": "string" },
        "company_name": { "type": "string" },
        "job_url": { "type": "string" },
        "application_form_text": { "type": "string" },
        "allow_public_lookup": { "type": "boolean" },
        "allow_ai": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sponsorshipAnalyzeResponse": {
      "type": "object",
      "required": ["trace_id", "sponsorship", "evidence", "ai_used"],
      "properties": {
        "trace_id": { "type": "string" },
        "sponsorship": {
          "type": "object",
          "required": [
            "status",
            "confidence",
            "summary",
            "risk_flags",
            "questions_to_confirm",
            "is_legal_conclusion"
          ],
          "properties": {
            "status": {
              "enum": [
                "supports",
                "does_not_support",
                "likely_supports",
                "likely_not_supports",
                "needs_confirmation",
                "unknown"
              ]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "summary": { "type": "string" },
            "risk_flags": { "type": "array", "items": { "type": "string" } },
            "questions_to_confirm": { "type": "array", "items": { "type": "string" } },
            "is_legal_conclusion": { "const": false }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "evidence_text", "evidence_url", "confidence"],
            "properties": {
              "source": { "type": "string" },
              "evidence_text": { "type": "string" },
              "evidence_url": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "ai_used": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "resumeTailorRequest": {
      "type": "object",
      "required": ["job_lead_id"],
      "properties": {
        "job_lead_id": { "type": "string" },
        "master_resume_id": { "type": "string" },
        "candidate_name": { "type": "string" },
        "contact_line": { "type": "string" },
        "master_resume_bullets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "format": { "const": "docx" },
            "target_length": { "type": "string" },
            "ats_friendly": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "success_reference_limit": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "resumeTailorResponse": {
      "type": "object",
      "required": ["trace_id", "resume_version", "used_success_references", "warnings"],
      "properties": {
        "trace_id": { "type": "string" },
        "resume_version": {
          "type": "object",
          "required": [
            "id",
            "job_lead_id",
            "source_master_resume_id",
            "created_at",
            "format",
            "file_path",
            "selected_bullets",
            "change_summary",
            "ai_output",
            "prompt_log_id",
            "version_label",
            "user_approved"
          ],
          "properties": {
            "id": { "type": "string" },
            "job_lead_id": { "type": "string" },
            "source_master_resume_id": { "type": "string" },
            "created_at": { "type": "string" },
            "format": { "const": "docx" },
            "file_path": { "type": "string" },
            "selected_bullets": { "type": "array", "items": { "type": "string" } },
            "change_summary": { "type": "string" },
            "ai_output": { "type": "object" },
            "prompt_log_id": { "type": "string" },
            "version_label": { "type": "string" },
            "user_approved": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "used_success_references": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "formAnswerDraftRequest": {
      "type": "object",
      "required": ["job_lead_id", "field_context"],
      "properties": {
        "job_lead_id": { "type": "string" },
        "application_id": { "type": "string" },
        "field_context": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "placeholder": { "type": "string" },
            "surrounding_text": { "type": "string" },
            "current_value": { "type": "string" },
            "input_type": { "type": "string" }
          },
          "additionalProperties": false
        },
        "jd_text": { "type": "string" },
        "master_resume_bullets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "profile_vault_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "formAnswerDraftResponse": {
      "type": "object",
      "required": ["trace_id", "draft", "ai_used"],
      "properties": {
        "trace_id": { "type": "string" },
        "draft": {
          "type": "object",
          "required": [
            "id",
            "job_lead_id",
            "application_id",
            "created_at",
            "field_label",
            "answer",
            "referenced_bullets",
            "risk_flags",
            "requires_user_review",
            "prompt_log_id"
          ],
          "properties": {
            "id": { "type": "string" },
            "job_lead_id": { "type": "string" },
            "application_id": { "type": "string" },
            "created_at": { "type": "string" },
            "field_label": { "type": "string" },
            "answer": { "type": "string" },
            "referenced_bullets": { "type": "array", "items": { "type": "string" } },
            "risk_flags": { "type": "array", "items": { "type": "string" } },
            "requires_user_review": { "const": true },
            "prompt_log_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "ai_used": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion"]
}

