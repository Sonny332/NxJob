{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxjob.local/schemas/api.schema.json",
  "title": "NxJob Phase 1 API Schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "sponsorshipStatus": {
      "enum": [
        "supports",
        "does_not_support",
        "likely_supports",
        "likely_not_supports",
        "needs_confirmation",
        "unknown"
      ]
    },
    "applicationStatus": {
      "enum": [
        "captured",
        "reviewing",
        "skipped",
        "tailored",
        "ready_to_apply",
        "applied",
        "replied",
        "interviewing",
        "offer",
        "rejected",
        "closed"
      ]
    },
    "workflowName": {
      "enum": [
        "analyze_sponsorship",
        "tailor_resume",
        "draft_form_answer_from_resume_bullets"
      ]
    },
    "sponsorshipAnalyzeRequest": {
      "type": "object",
      "required": ["job_lead_id"],
      "properties": {
        "job_lead_id": { "type": "string" },
        "jd_text": { "type": "string" },
        "company_name": { "type": "string" },
        "job_url": { "type": "string" },
        "application_form_text": { "type": "string" },
        "allow_public_lookup": { "type": "boolean" },
        "allow_ai": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sponsorshipAnalyzeResponse": {
      "type": "object",
      "required": ["trace_id", "sponsorship", "evidence", "ai_used"],
      "properties": {
        "trace_id": { "type": "string" },
        "sponsorship": {
          "type": "object",
          "required": [
            "status",
            "confidence",
            "summary",
            "risk_flags",
            "questions_to_confirm",
            "is_legal_conclusion"
          ],
          "properties": {
            "status": {
              "enum": [
                "supports",
                "does_not_support",
                "likely_supports",
                "likely_not_supports",
                "needs_confirmation",
                "unknown"
              ]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "summary": { "type": "string" },
            "risk_flags": { "type": "array", "items": { "type": "string" } },
            "questions_to_confirm": { "type": "array", "items": { "type": "string" } },
            "is_legal_conclusion": { "const": false }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "evidence_text", "evidence_url", "confidence"],
            "properties": {
              "source": { "type": "string" },
              "evidence_text": { "type": "string" },
              "evidence_url": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "ai_used": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion"]
}

