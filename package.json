{
  "name": "nxjob",
  "version": "0.1.0",
  "private": true,
  "description": "NxJob MVP monorepo",
  "workspaces": [
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "extension:dev": "npm --workspace @nxjob/extension run dev",
    "extension:build": "npm --workspace @nxjob/extension run build",
    "extension:typecheck": "npm --workspace @nxjob/extension run typecheck",
    "shared:check": "npm --workspace @nxjob/shared run check"
  }
}

